{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "value-chain",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",

  // serve /public, but let the Worker see every request first so /api/* routes
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },

  // SQLite-backed Durable Objects — this is the backend available on the free plan
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],

  "observability": { "enabled": true }
}
